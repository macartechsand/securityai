# Backend configuration. Copy to backend/.env for local use. Never commit the real file.

# --- Model provider (secret: backend only) ---
GEMINI_API_KEY=
# Model name is configurable because model names change over time. Check the current
# list at https://ai.google.dev/gemini-api/docs/models before deploying.
GEMINI_MODEL=gemini-2.5-flash
# 0 disables "thinking" on Gemini 2.5 Flash so the output-token limit is not consumed before the
# answer starts. Remove this line for models that do not support it (it would cause HTTP 400).
GEMINI_THINKING_BUDGET=0

# --- CORS ---
# Comma-separated list of exact frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Limits ---
MAX_MESSAGE_CHARS=2000
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_CHARS=6000
MAX_OUTPUT_TOKENS=1024
MODEL_TIMEOUT_SECONDS=25
TEMPERATURE=0.3

# --- Rate limiting (in-memory, per client IP, per process) ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Set to true ONLY when running behind a trusted reverse proxy (Render, Fly, etc.)
# so the client IP is read from X-Forwarded-For. Leave false otherwise: the header is spoofable.
TRUST_PROXY_HEADERS=false

LOG_LEVEL=INFO
